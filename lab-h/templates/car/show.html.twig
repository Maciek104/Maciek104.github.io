{% extends 'base.html.twig' %}

{% block title %}Car details{% endblock %}

{% block body %}
    <div class="container mt-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>Car details</h1>

            <div>
                <a class="btn btn-secondary" href="{{ path('app_car_index') }}">
                    ← Back
                </a>

                <a class="btn btn-warning"
                   href="{{ path('app_car_edit', {'id': car.id}) }}">
                    Edit
                </a>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">

                <table class="table table-striped mb-0">
                    <tbody>
                    <tr>
                        <th>ID</th>
                        <td>{{ car.id }}</td>
                    </tr>
                    <tr>
                        <th>Make</th>
                        <td>{{ car.make }}</td>
                    </tr>
                    <tr>
                        <th>Model</th>
                        <td>{{ car.model }}</td>
                    </tr>
                    <tr>
                        <th>Year</th>
                        <td>{{ car.year }}</td>
                    </tr>
                    <tr>
                        <th>Price</th>
                        <td>{{ car.price }}</td>
                    </tr>
                    </tbody>
                </table>

            </div>
        </div>

        <div class="mt-3">
            {{ include('car/_delete_form.html.twig') }}
        </div>

    </div>
{% endblock %}
