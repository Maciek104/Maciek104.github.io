<!DOCTYPE html>
<html>
    <head>
        <title>Dodaj nowy samochód</title>
        <link rel='stylesheet' href='/stylesheets/style.css' />
    </head>
    <body>
        <main>
            <h1>Dodaj nowy samochód</h1>
            <form action="/cars/create" method="POST">
                    <label>Producent: <input type="text" name="producent" required></label><br>
                    <label>Model: <input type="text" name="model" required></label><br>
                    <label>Rok: <input type="number" name="rok" required></label><br>
                    <label>Cena: <input type="number" step="0.01" name="cena" required></label><br>
                    <button type="submit">Dodaj</button>
            </form>
            <a href="/cars">Powrót do listy</a>
        </main>
    </body>
</html>