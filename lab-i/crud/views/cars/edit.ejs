<!DOCTYPE html>
<html>
    <head>
        <title>Edytuj samochód</title>
        <link rel='stylesheet' href='/stylesheets/style.css' />
    </head>
    <body>
        <main>
            <h1>Edytuj samochód</h1>
            <form action="/cars/edit/<%= car.id %>" method="POST">
                    <label>Producent: <input type="text" name="producent" value="<%= car.producent %>" required></label><br>
                    <label>Model: <input type="text" name="model" value="<%= car.model %>" required></label><br>
                    <label>Rok: <input type="number" name="rok" value="<%= car.rok %>" required></label><br>
                    <label>Cena: <input type="number" step="0.01" name="cena" value="<%= car.cena %>" required></label><br>
                    <button type="submit">Zapisz zmiany</button>
            </form>
            <a href="/cars">Powrót do listy</a>
        </main>
    </body>
</html>